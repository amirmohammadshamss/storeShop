BACKEND_API_URL=https://adminchannel.ir/api/v1/
# Generate a random server-only secret of at least 32 characters for checkout drafts.
CHECKOUT_DRAFT_SECRET=
# Enable only after order authorization and response contracts are verified.
ORDER_LOOKUP_ENABLED=false
# Public catalog cache TTL (0 disables caching; maximum 300). Checkout/orders always bypass it.
BACKEND_CATALOG_TTL_SECONDS=0
# Exact public origin (e.g. https://shop.example.com) for checkout requests behind a proxy.
APP_ORIGIN=
# Verified HTTPS public origin and an explicit sitemap/indexing store allowlist. Disabled by default.
SITE_ORIGIN=
CATALOG_INDEXING_ENABLED=false
PUBLIC_STORE_CODES=
