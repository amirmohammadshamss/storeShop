{
  "name": "storeshop",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests next.config.ts eslint.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:source": "tsx scripts/check-source.ts",
    "smoke": "tsx scripts/smoke.ts",
    "verify:production": "node --import tsx scripts/verify-production.ts",
    "worker:build": "node --import tsx scripts/build-worker.ts",
    "predev": "npm run worker:build",
    "prebuild": "npm run worker:build",
    "pretest": "npm run worker:build",
    "pretypecheck": "npm run worker:build",
    "prelint": "npm run worker:build",
    "precheck:source": "npm run worker:build"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "jiti": "2.7.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module"
}
